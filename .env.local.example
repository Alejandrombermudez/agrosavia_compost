# Copia este archivo como ".env.local" y llena los valores
# para desarrollo local. Para producción, agrégalos en Vercel
# (ver instrucciones al final del README o en el apartado de Vercel).

FIREBASE_PROJECT_ID=pilas-compost
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-5gm8n@pilas-compost.iam.gserviceaccount.com

# La private key va entre comillas. Los \n deben quedar literales (no saltos reales).
# Cópiala exactamente como aparece en el JSON del service account.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
